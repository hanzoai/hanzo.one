# The gui compiler bundles src/gui/config.ts into `.hanzogui/` and re-resolves
# the externals from there with plain node resolution. pnpm's default layout
# only exposes DIRECT dependencies at the package root, so `@hanzogui/web` —
# reached through @hanzo/gui, never named here — was invisible and the config
# bundle failed with "Cannot find package '@hanzogui/web'". Extraction then had
# no components and silently emitted nothing.
public-hoist-pattern[]=@hanzogui/*
